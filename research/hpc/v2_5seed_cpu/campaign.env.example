# Copy this file to campaign.env, replace REPLACE_ACCOUNT, then source it.
# campaign.env is gitignored so account and filesystem details stay local.

export HUNGER_SLURM_ACCOUNT="REPLACE_ACCOUNT"
export HUNGER_RESEARCH_ROOT="/resnick/home/$USER/Hunger_games_2/research"
export HUNGER_CAMPAIGN_ROOT="/resnick/home/$USER/hunger_runs/v2_5seed_ippo_mappo_1500"
export HUNGER_HPC_VENV="/resnick/home/$USER/envs/hunger-v2-ray253-cpu"

# Resnick's available Python 3.11 module. Setup and batch scripts load it.
export HUNGER_PYTHON_MODULE="python/3.11.6-gcc-11.3.1-rphh4kv"
export HUNGER_PYTHON_BIN="python3"
